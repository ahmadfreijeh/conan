APP_NAME=conan
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/conan
REDIS_URL=redis://localhost:6379/0

# Image engine
ENGINE_DEVICE=auto
DETECT_BOX_THRESHOLD=0.30
DETECT_TEXT_THRESHOLD=0.25
DETECT_GROUPS=all
DETECT_BATCH_SIZE=25
OCR_DET_MODEL=mobile
OCR_REC_MODELS=PP-OCRv6_medium_rec,arabic_PP-OCRv5_mobile_rec
OCR_MIN_SCORE=0.5
ENGINE_RUNS_LOG=out/runs.jsonl

# Reasoning agent (app/modules/agent)
ANTHROPIC_API_KEY=
REASON_MODEL=claude-sonnet-5-5
REASON_MAX_TOKENS=16000
REASON_CACHE=true
SPEND_LOG=out/spend.jsonl
CREDIT_BUDGET=0
REASON_MAX_CROPS=6

# Agent tools (app/modules/agent/tools)
# AGENT_TOOLS=find_place,reverse_geocode,wiki_search,wiki_summary,wiki_nearby  (unset = all)
AGENT_MAX_LOOKUPS=10
AGENT_APPROVAL=listed
AGENT_APPROVAL_TIMEOUT=300
TOOLS_CONTACT=you@example.com
PLACES_URL=https://nominatim.openstreetmap.org
PLACES_TIMEOUT=10
WIKI_URL=https://{lang}.wikipedia.org/w
WIKI_TIMEOUT=10
